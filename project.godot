; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Duck-game"
run/main_scene="uid://bpixkaenh04wb"
config/features=PackedStringArray("4.5", "C#", "Mobile")
boot_splash/bg_color=Color(0.10408481, 0.108385555, 0.11022247, 1)
config/icon="res://trash/icon.svg"

[display]

window/size/viewport_width=648
window/size/viewport_height=1152
window/stretch/mode="viewport"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Duck-game"

[global_group]

duck=""
ground=""
river=""
chick=""
bridge=""

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="collision"
2d_physics/layer_2="land"
2d_physics/layer_3="stick"
2d_physics/layer_4="chickStone"
2d_physics/layer_5="river"
2d_physics/layer_6="bridge"
2d_physics/layer_7="bridge sides"

[physics]

2d/default_gravity=300.0
2d/default_gravity_vector=Vector2(0, 0)

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
